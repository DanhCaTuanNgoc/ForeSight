# =======================================================
# ForeSight Terminal: Somnia × DreamDEX Environment Config
# =======================================================

# ── Target Network & Endpoints ─────────────────────────
# Target Network: testnet | mainnet
NETWORK=testnet

# Somnia Shannon Testnet (Chain ID: 50312) RPC & Indexer
RPC_URL=https://api.infra.testnet.somnia.network
WS_RPC_URL=wss://api.infra.testnet.somnia.network/ws
INDEXER_URL=https://dev.smk.somnia.host/v1/graphql

# DreamDEX Event Contracts Venue ID
# Testnet default: 0x679795a0195a1b76cdebb7c51d74e058aee92919b8c3389af86ef24535e8a28c
# Mainnet default: 0x458b30c2d72bfd2c6317304a4594ecbafe5f729d3111b65fdc3a33bd48e5432d
VENUE_ID=0x679795a0195a1b76cdebb7c51d74e058aee92919b8c3389af86ef24535e8a28c

# ── Wallet Private Key (Optional for Read-Only / Doctor, Required for Live On-Chain Trading) ──
# Format: 64 hex characters (with or without 0x prefix)
PRIVATE_KEY=your_somnia_testnet_private_key_here

# ── Supabase (Cloud PostgreSQL Persistence) ────────────
# Get these from https://supabase.com → Project → Settings → API
SUPABASE_URL=your_supabase_project_url_here
SUPABASE_ANON_KEY=your_supabase_anon_key_here

# ── News Ingestion & Real-Time RAG ─────────────────────
# CryptoPanic API token (optional, free tier: https://cryptopanic.com/developers/api/)
CRYPTOPANIC_TOKEN=

# ── Auto-Claim & Settlement Sweeper Settings ───────────
AUTO_CLAIM=true
AUTO_CLAIM_INTERVAL_MS=600000
CLAIM_SCAN_DEPTH=25

# ── Risk & Execution Limits ────────────────────────────
MAX_ORDER_SIZE_USDC=50
DEFAULT_SLIPPAGE_TOLERANCE=0.02
POLL_INTERVAL_MS=3000

# ── LLM Reasoning Engines (Dual Debate Arena) ──────────
# Gemini API Key (Optional / fallback): https://aistudio.google.com/
GEMINI_API_KEY=
DISABLE_GEMINI=false

# OpenRouter API Key (Supports Meta LLaMA 3.3, Claude, GPT-4o): https://openrouter.ai/
OPENROUTER_API_KEY=your_openrouter_api_key_here

# ── Server Port (Backend API) ──────────────────────────
PORT=3001
