# =======================================================
# Somnia × DreamDEX Event Contracts Copilot Configuration
# =======================================================

# Target Network: testnet | mainnet
NETWORK=testnet

# Somnia Shannon Testnet RPC & Indexer
RPC_URL=https://api.infra.testnet.somnia.network
WS_RPC_URL=wss://api.infra.testnet.somnia.network/ws
INDEXER_URL=https://dev.smk.somnia.host/v1/graphql

# DreamDEX Event Contracts Venue ID
# Testnet default: 0x679795a0195a1b76cdebb7c51d74e058aee92919b8c3389af86ef24535e8a28c
# Mainnet default: 0x458b30c2d72bfd2c6317304a4594ecbafe5f729d3111b65fdc3a33bd48e5432d
VENUE_ID=0x679795a0195a1b76cdebb7c51d74e058aee92919b8c3389af86ef24535e8a28c

# Wallet Private Key (Optional for Read-Only / Doctor, Required for Placing Orders & Claiming)
# Format: 0x followed by 64 hex characters
PRIVATE_KEY=

# ── Supabase (Cloud PostgreSQL) ──
# Get these from https://supabase.com → Project → Settings → API
SUPABASE_URL=
SUPABASE_ANON_KEY=

# ── News Ingestion ──
# CryptoPanic API token (optional, free tier: https://cryptopanic.com/developers/api/)
CRYPTOPANIC_TOKEN=

# Auto-Claim Settings
AUTO_CLAIM=true
AUTO_CLAIM_INTERVAL_MS=600000
CLAIM_SCAN_DEPTH=25

# Risk & Order Limits
MAX_ORDER_SIZE_USDC=50
DEFAULT_SLIPPAGE_TOLERANCE=0.02
POLL_INTERVAL_MS=3000
