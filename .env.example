# ── Network & Somnia DreamDEX Config ──────────────────────────────────────────
NETWORK=testnet
RPC_URL=https://dream-rpc.somnia.network
WS_RPC_URL=wss://dream-rpc.somnia.network/ws
INDEXER_URL=https://indexer-testnet.somnia.network
VENUE_ID=0x0000000000000000000000000000000000000000

# ── Wallet Private Key (Optional for Read-only / Simulated mode) ─────────────
# PRIVATE_KEY=0x...

# ── Supabase Database (Optional for History & News) ───────────────────────────
SUPABASE_URL=
SUPABASE_ANON_KEY=

# ── News Ingestion (Optional) ────────────────────────────────────────────────
# CRYPTOPANIC_TOKEN=

# ── Server Port (Automatically set by Railway) ────────────────────────────────
PORT=3001
